          FROM (
              SELECT [s0].[Value], [s0].[Time], [s0].[Status], 1 AS [c], [s0].[ConstructionCode], [s0].[StationCode], ROW_NUMBER() OVER(PARTITION BY [s0].[ConstructionCode], [s0].[StationCode] ORDER BY [s0].[Time] DESC) AS [row]
