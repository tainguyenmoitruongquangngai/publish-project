          LEFT JOIN (
              SELECT [g0].[Id], [g0].[IdGP], [g0].[IdTCQ], [t6].[Id] AS [Id0], [t6].[CoQuanCP], [t6].[DaXoa], [t6].[FilePDF], [t6].[GhiChu], [t6].[IdCon], [t6].[NgayKy], [t6].[SoQDTCQ], [t6].[TaiKhoanSua], [t6].[TaiKhoanTao], [t6].[ThoiGianSua], [t6].[ThoiGianTao], [t6].[TongTienCQ]
